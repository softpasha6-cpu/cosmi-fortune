# Set these as private environment variables in your hosting dashboard.
# BOT_TOKEN: token for @CosmicFortune_bot from BotFather; never commit the real token.
BOT_TOKEN=replace_with_botfather_token
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: comma-separated frontend origins
ALLOWED_ORIGINS=https://softpasha6-cpu.github.io
PORT=3000
